{
  "name": "tracking-mqtt-bridge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "mqtt": "^5.14.1",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.11.0",
    "pino-pretty": "^13.0.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0"
  }
}
