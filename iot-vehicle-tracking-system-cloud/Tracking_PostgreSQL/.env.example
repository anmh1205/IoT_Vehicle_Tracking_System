# Generate secrets with: openssl rand -base64 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=vehicle_tracking
# Provide a unique password >=16 characters for new-volume admin provisioning.
# Existing PostgreSQL data volumes are not automatically migrated or rotated.
POSTGRES_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
# PostgreSQL is reachable from Docker services on tracking-network and from
# localhost by default; explicitly opt in to remote host exposure if needed.
POSTGRES_BIND_ADDRESS=127.0.0.1
PG_CONTAINER_NAME=tracking-postgres
