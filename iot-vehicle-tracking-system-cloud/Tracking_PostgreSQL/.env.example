# Generate secrets with: openssl rand -base64 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=vehicle_tracking
# Required on deployment startup. Provision a unique >=16 character value.
# Existing volumes keep their current admin hash; rotate known old passwords separately.
POSTGRES_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
# Database port is loopback-only by default. Set POSTGRES_BIND_ADDRESS only
# for an explicitly protected maintenance interface; prefer VPN/SSH tunneling.
POSTGRES_BIND_ADDRESS=127.0.0.1
PG_CONTAINER_NAME=tracking-postgres
