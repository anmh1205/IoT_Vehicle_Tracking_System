# Server
PORT=4000
NODE_ENV=development

# Generate secrets with: openssl rand -base64 32

# PostgreSQL
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=vehicle_tracking
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# VictoriaMetrics & VictoriaLogs
VICTORIAMETRICS_URL=http://localhost:8428
VICTORIALOGS_URL=http://localhost:9428

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USE_TLS=true   # REQUIRED: enforce TLS MQTT
MQTT_REJECT_UNAUTHORIZED=true   # REQUIRED: reject untrusted TLS certs
MQTT_USERNAME=backend
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
# Stable ID for the durable internal/events/# subscriber. Each backend replica
# must use a unique stable value; do not randomize this across process restarts.
MQTT_LISTENER_CLIENT_ID=tracking-backend-listener
MQTT_BRIDGE_HEALTH_URL=http://tracking-mqtt-bridge:4003

# Session Auth
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_32_BYTES
SESSION_MAX_LIFETIME_HOURS=24
SESSION_EXTENSION_HOURS=4

# CORS
CORS_ORIGIN=http://localhost:4001

# Observability (all optional)
SENTRY_DSN=                    # Optional - Sentry error tracking DSN
METRICS_PASSWORD=CHANGE_ME_METRICS_PASSWORD
LOG_LEVEL=info                 # debug | info | warn | error

# Firmware artifact storage
FIRMWARE_STORAGE_PATH=/app/firmware
FIRMWARE_PUBLIC_BASE_URL=      # Optional. Example: https://api.example.com
OTA_ASSIGNED_TIMEOUT_SEC=600   # Reconcile window: assigned but no firmware event
OTA_IN_PROGRESS_TIMEOUT_SEC=900 # Reconcile window: no progress while downloading/verifying/installing/confirming
