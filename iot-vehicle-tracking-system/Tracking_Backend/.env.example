# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=vehicle_tracking
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=           # REQUIRED

# VictoriaMetrics & VictoriaLogs
VICTORIAMETRICS_URL=http://localhost:8428
VICTORIALOGS_URL=http://localhost:9428

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USE_TLS=false  # Set true in production
MQTT_REJECT_UNAUTHORIZED=false  # Set true in production
MQTT_USERNAME=backend
MQTT_PASSWORD=                 # REQUIRED

# Session Auth
SESSION_SECRET=                # REQUIRED - min 32 chars
SESSION_MAX_LIFETIME_HOURS=24
SESSION_EXTENSION_HOURS=4

# CORS
CORS_ORIGIN=http://localhost:3002

# Observability (all optional)
SENTRY_DSN=                    # Optional - Sentry error tracking DSN
METRICS_PASSWORD=              # REQUIRED in production - basic auth password for /metrics endpoint
LOG_LEVEL=info                 # debug | info | warn | error
