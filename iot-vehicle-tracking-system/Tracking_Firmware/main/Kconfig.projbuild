menu "Tracker Firmware"

config TRACKER_DEFAULT_DEVICE_ID
    string "Default device ID"
    default "TRACKER_001"

config TRACKER_DEFAULT_AUTH_TOKEN
    string "Default auth token"
    default "device-secret-token"

config TRACKER_DEFAULT_MQTT_HOST
    string "Default MQTT host"
    default "localhost"

config TRACKER_DEFAULT_MQTT_PORT
    int "Default MQTT port"
    range 1 65535
    default 1883

config TRACKER_DEFAULT_HEARTBEAT_INTERVAL_S
    int "Heartbeat interval (seconds)"
    range 60 86400
    default 900

config TRACKER_DEFAULT_TRACKING_INTERVAL_S
    int "Tracking interval (seconds)"
    range 1 3600
    default 10

config TRACKER_ENABLE_COMMAND_SUBSCRIBE
    bool "Subscribe command topic"
    default y

config TRACKER_MODEM_APN
    string "Cellular APN"
    default "internet"

endmenu
