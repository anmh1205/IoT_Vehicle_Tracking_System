{
  "theme": "base",
  "fontFamily": "Noto Sans, Segoe UI, Arial, sans-serif",
  "securityLevel": "strict",
  "deterministicIds": true,
  "markdownAutoWrap": false,
  "themeVariables": {
    "primaryColor": "#f8fafc",
    "primaryBorderColor": "#1f2937",
    "primaryTextColor": "#111827",
    "lineColor": "#1f2937",
    "secondaryColor": "#ffffff",
    "tertiaryColor": "#eef2ff",
    "clusterBkg": "#f1f5f9",
    "clusterBorder": "#64748b",
    "fontSize": "18px"
  },
  "flowchart": {
    "defaultRenderer": "elk",
    "curve": "basis",
    "htmlLabels": false,
    "nodeSpacing": 120,
    "rankSpacing": 160,
    "padding": 28,
    "wrappingWidth": 220,
    "useMaxWidth": false
  },
  "sequence": {
    "diagramMarginX": 90,
    "diagramMarginY": 50,
    "actorMargin": 130,
    "messageMargin": 70,
    "width": 260,
    "height": 90,
    "boxMargin": 20,
    "boxTextMargin": 14,
    "noteMargin": 18,
    "wrap": true
  }
}