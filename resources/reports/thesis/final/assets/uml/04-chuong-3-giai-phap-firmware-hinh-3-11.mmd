flowchart TB
    Check{"Ignition?"}
    Drive["DRIVING"]
    Park["PARKED"]
    Beat["HEARTBEAT"]
    Sleep["SLEEP"]
    Alarm["ALARM"]

    Check -->|ON| Drive
    Check -->|OFF| Park

    Drive -->|OFF| Park
    Park -->|ON| Drive

    Park -->|timer| Beat
    Beat -->|theo dõi nền| Park
    Beat -->|sleep OK| Sleep

    Park -. IMU .-> Alarm
    Sleep -->|RTC| Beat
    Sleep -. IMU .-> Alarm
    Sleep -->|ON| Drive

    Alarm -->|xử lý xong| Park
    Alarm -->|ON| Drive
