stateDiagram-v2
    direction TB
    state "Lấy mẫu" as Sample
    state "Kiểm tra IGN" as IgnCheck
    state "Nguồn chính" as Main
    state "Kiểm tra điện áp" as VoltCheck
    state "Nguồn dự phòng" as Backup
    state "Phục hồi nguồn" as Recover
    state "Giữ trạng thái" as Hold

    [*] --> Sample
    Sample --> IgnCheck
    IgnCheck --> Main: Bật IGN
    IgnCheck --> VoltCheck: Tắt IGN
