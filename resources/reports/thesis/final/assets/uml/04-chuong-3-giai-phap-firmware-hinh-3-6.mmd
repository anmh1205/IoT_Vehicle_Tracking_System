flowchart TB
    Wake["Nguồn đánh thức<br/>Timer / IMU EXT0"] --> MainLoop["Vòng điều khiển chính<br/>app_main + state_machine_run()"]

    subgraph Sync["Primitive FreeRTOS dùng có chọn lọc"]
        direction LR
        Nimble["NimBLE<br/>Host task"]
        BleMgr["ble_mgr<br/>Queue + mutex"]
        BleObd["ble_obd<br/>Semaphore phản hồi"]
        ModemAt["modem_at<br/>Mutex UART"]
    end

    Sensors["ADC / IMU / RTC / GNSS"]
    Queue["offline_queue<br/>MicroSD replay theo ACK/QoS"]
    MQTT["mqtt_client<br/>rawdata / status / events / firmware / commands"]
    Broker["EMQX"]

    MainLoop --> Sensors
    MainLoop --> Nimble
    MainLoop --> BleMgr
    MainLoop --> BleObd
    MainLoop --> ModemAt
    MainLoop --> Queue
    MainLoop --> MQTT
    Queue --> MQTT
    MQTT -->|rawdata / status / events / firmware| Broker
    Broker -->|Topic commands| MQTT
