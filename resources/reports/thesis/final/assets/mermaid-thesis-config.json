{
  "theme": "base",
  "fontFamily": "Noto Sans, Segoe UI, Arial, sans-serif",
  "securityLevel": "strict",
  "deterministicIds": true,
  "markdownAutoWrap": false,
  "themeVariables": {
    "primaryColor": "#f8fafc",
    "primaryBorderColor": "#1f2937",
    "primaryTextColor": "#111827",
    "lineColor": "#1f2937",
    "secondaryColor": "#ffffff",
    "tertiaryColor": "#eef2ff",
    "clusterBkg": "#f1f5f9",
    "clusterBorder": "#64748b",
    "fontSize": "22px"
  },
  "flowchart": {
    "defaultRenderer": "dagre",
    "curve": "linear",
    "htmlLabels": false,
    "nodeSpacing": 120,
    "rankSpacing": 140,
    "padding": 20,
    "wrappingWidth": 260,
    "useMaxWidth": false
  },
  "sequence": {
    "diagramMarginX": 36,
    "diagramMarginY": 30,
    "actorMargin": 72,
    "messageMargin": 40,
    "width": 170,
    "height": 72,
    "boxMargin": 14,
    "boxTextMargin": 10,
    "noteMargin": 12,
    "wrap": true
  }
}
