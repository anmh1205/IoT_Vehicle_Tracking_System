{
  "schemaVersion": "2026-04-10",
  "targetServices": ["tracking-mqtt-bridge", "tracking-backend"],
  "checkpointOrder": [
    "health-backend",
    "docker-service-state",
    "broker-connectivity",
    "bridge-logs",
    "backend-logs"
  ],
  "commands": {
    "health-backend": {
      "type": "http",
      "method": "GET",
      "url": "http://127.0.0.1:4000/health",
      "timeoutMs": 5000
    },
    "docker-service-state": {
      "type": "ssh",
      "command": "docker ps --format '{{.Names}}|{{.Status}}' | grep -E 'tracking-backend|tracking-mqtt-bridge'",
      "timeoutMs": 10000
    },
    "broker-connectivity": {
      "type": "ssh",
      "command": "docker ps --format '{{.Names}}' | grep -E 'emqx'",
      "timeoutMs": 10000
    },
    "bridge-logs": {
      "type": "ssh",
      "command": "docker logs --tail 120 tracking-mqtt-bridge",
      "timeoutMs": 30000
    },
    "backend-logs": {
      "type": "ssh",
      "command": "docker logs --tail 120 tracking-backend",
      "timeoutMs": 30000
    }
  }
}
