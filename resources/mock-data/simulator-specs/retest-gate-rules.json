{
  "schemaVersion": "2026-04-10",
  "singleHardFailGate": true,
  "rules": {
    "pass": [
      "deliveryRatio >= deliveryRatioMin",
      "ingestRatio >= ingestRatioMin",
      "latencyP95Ms <= latencyP95MsMax",
      "errorRate <= errorRateMax"
    ],
    "retest": [
      "classifier in [network, broker_connectivity]",
      "iteration < maxIterations"
    ],
    "fail": [
      "sameClassifierCount >= sameClassifierHardStopThreshold",
      "runDurationSec > maxRunDurationSec"
    ]
  }
}
