{
  "schemaVersion": "2026-04-10",
  "sourceOfTruth": "README MQTT contract + bridge validator",
  "metadata": {
    "requiredFields": ["schema_version", "message_id", "sent_at", "seq_no", "boot_id"],
    "notes": "status topic defaults to non-retain in UAT; retain only when a scenario explicitly enables it"
  },
  "topics": [
    {
      "topicTemplate": "v1/{device_id}/rawdata",
      "direction": "device_to_server",
      "qos": 0,
      "retainDefault": false,
      "requiredFields": ["device_id", "data"]
    },
    {
      "topicTemplate": "v1/{device_id}/status",
      "direction": "device_to_server",
      "qos": 1,
      "retainDefault": false,
      "requiredFields": ["device_id", "status"]
    },
    {
      "topicTemplate": "v1/{device_id}/events",
      "direction": "device_to_server",
      "qos": 1,
      "retainDefault": false,
      "requiredFields": ["device_id", "event_type", "code", "message"]
    },
    {
      "topicTemplate": "v1/{device_id}/firmware",
      "direction": "device_to_server",
      "qos": 1,
      "retainDefault": false,
      "requiredFields": ["device_id", "firmware_status"]
    },
    {
      "topicTemplate": "v1/{device_id}/commands",
      "direction": "server_to_device",
      "qos": 1,
      "retainDefault": false,
      "requiredFields": ["command"]
    }
  ]
}
