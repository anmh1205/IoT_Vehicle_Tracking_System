sequenceDiagram
    autonumber
    participant APP as app_main
    participant NVS as nvs_config
    participant FSM as state_machine
    participant RTC as g_rtc_context
    participant LTE as modem_lte
    participant MQTT as mqtt_client

    APP->>NVS: nvs_config_init()
    APP->>NVS: nvs_config_load(&config)
    APP->>APP: apply field-validation overrides
    APP->>RTC: boot_count++
    APP->>APP: choose initial state from wakeup cause

    loop until init succeeds
        APP->>FSM: state_machine_init(&config)
        FSM->>LTE: modem_lte_request_connect()
        FSM->>MQTT: tracker_mqtt_init(&config)
    end

    loop every 100 ms
        APP->>FSM: state_machine_run(current_state)
        FSM->>FSM: tick one runtime step
    end
