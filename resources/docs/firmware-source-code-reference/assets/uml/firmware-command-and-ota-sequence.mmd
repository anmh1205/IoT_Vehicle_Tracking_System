sequenceDiagram
    autonumber
    participant Cloud
    participant MQTT as mqtt_client
    participant CMD as command_handler
    participant FSM as state_machine
    participant OTA as util_ota_apply_update
    participant RTC as g_rtc_context
    participant Boot as next boot

    Cloud->>MQTT: publish ota_update
    MQTT->>CMD: command_handler_process(payload)
    CMD-->>FSM: COMMAND_ACTION_OTA_UPDATE
    FSM->>FSM: safety gate (mqtt + battery)
    FSM->>OTA: download + hash verify + set boot partition
    OTA-->>FSM: success
    FSM->>RTC: store pending confirm context
    FSM->>Boot: esp_restart()
    Boot->>FSM: state_machine_try_confirm_running_firmware()
    FSM->>FSM: esp_ota_mark_app_valid_cancel_rollback()
    FSM->>MQTT: publish firmware success
