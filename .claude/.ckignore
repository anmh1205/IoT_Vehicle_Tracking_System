# ClaudeKit Ignore File - SIZE-based blocking
# Blocks directories with heavy file counts that fill LLM context
# Syntax: gitignore-spec | Use ! prefix to allow (e.g., !src/vendor)

# JS/TS
node_modules
resources/reports/diagram-reference-packs/**/node_modules
dist
build
!resources/reports/diagram-reference-packs/**/build
!resources/reports/diagram-reference-packs/**/build/**
.next
.nuxt

# Python
__pycache__
.venv
venv

# Go/PHP/Rust/Java
vendor
target

# VCS & Coverage
.git
coverage

# Allow reading these files
!.env
!.env.*