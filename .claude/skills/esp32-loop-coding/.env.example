# Optional defaults for esp32-loop-coding scripts
ESP32_DEFAULT_PORT=COM6
ESP32_BAUD=115200
ESP32_MAX_SECONDS=120
ESP32_STABLE_SECONDS=20
ESP32_QUIET_SECONDS=3
ESP32_MAX_ITERATIONS=8
ESP32_FLASH_BAUD=460800

# Remote SSH defaults
# Copy these into .env and replace placeholders with your actual machine A values.
ESP32_REMOTE_HOST=your-machine-a-host
ESP32_REMOTE_USER=your-ssh-user
ESP32_REMOTE_KEY_PATH=E:/path/to/private-key
ESP32_REMOTE_TIMEOUT_SECONDS=15
ESP32_REMOTE_STRICT_HOST_KEY_CHECKING=true
ESP32_REMOTE_PREFERRED_VID=0x303A
ESP32_REMOTE_PREFERRED_PID=0x1001
ESP32_REMOTE_STAGE_DIR=C:/Users/your-user/esp32-remote-flash
ESP32_REMOTE_PYTHON=D:/ESP_IDF/Espressif/python_env/idf5.5_py3.11_env/Scripts/python.exe
ESP32_REMOTE_ESPTOOL=D:/ESP_IDF/esp/v5.5.1/esp-idf/components/esptool_py/esptool/esptool.py
ESP32_REMOTE_EXPORT_PS1=D:/ESP_IDF/esp/v5.5.1/esp-idf/export.ps1
ESP32_REMOTE_IDF_PY=D:/ESP_IDF/esp/v5.5.1/esp-idf/tools/idf.py
