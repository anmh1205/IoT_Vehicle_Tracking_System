menu "Tracker Firmware"

config TRACKER_DEFAULT_DEVICE_ID
    string "Default device ID"
    default "TRACKER_001"

config TRACKER_DEFAULT_AUTH_TOKEN
    string "Default auth token"
    default "device-secret-token"

config TRACKER_DEFAULT_MQTT_HOST
    string "Default MQTT host"
    default "localhost"

config TRACKER_DEFAULT_MQTT_PORT
    int "Default MQTT port"
    range 1 65535
    default 1883

config TRACKER_DEFAULT_HEARTBEAT_INTERVAL_S
    int "Heartbeat interval (seconds)"
    range 60 86400
    default 900

config TRACKER_DEFAULT_TRACKING_INTERVAL_S
    int "Tracking interval (seconds)"
    range 1 3600
    default 10

config TRACKER_ENABLE_COMMAND_SUBSCRIBE
    bool "Subscribe command topic"
    default y

config TRACKER_MODEM_APN
    string "Cellular APN"
    default "internet"

config TRACKER_SD_LOG_ENABLE
    bool "Enable SD logging"
    default y

config TRACKER_SD_REPLAY_ENABLE
    bool "Enable SD replay"
    default y

config TRACKER_SD_DIAG_ENABLE
    bool "Enable SD diagnostics counters"
    default y

config TRACKER_SDMMC_BUS_WIDTH
    int "SDMMC bus width"
    range 1 4
    default 4

config TRACKER_SDMMC_GPIO_CLK
    int "SDMMC CLK GPIO"
    range -1 48
    default -1

config TRACKER_SDMMC_GPIO_CMD
    int "SDMMC CMD GPIO"
    range -1 48
    default -1

config TRACKER_SDMMC_GPIO_D0
    int "SDMMC DAT0 GPIO"
    range -1 48
    default -1

config TRACKER_SDMMC_GPIO_D1
    int "SDMMC DAT1 GPIO"
    range -1 48
    default -1

config TRACKER_SDMMC_GPIO_D2
    int "SDMMC DAT2 GPIO"
    range -1 48
    default -1

config TRACKER_SDMMC_GPIO_D3
    int "SDMMC DAT3 GPIO"
    range -1 48
    default -1

config TRACKER_SDMMC_GPIO_CD
    int "SDMMC card-detect GPIO"
    range -1 48
    default -1

config TRACKER_SDMMC_GPIO_WP
    int "SDMMC write-protect GPIO"
    range -1 48
    default -1

config TRACKER_SDMMC_CD_ACTIVE_LOW
    bool "Card detect active low"
    default y

config TRACKER_SD_LOG_QUOTA_BYTES
    int "SD queue quota bytes"
    range 131072 134217728
    default 4194304

config TRACKER_SD_LOG_SOFT_QUOTA_PERCENT
    int "SD queue soft quota percent"
    range 50 95
    default 80

config TRACKER_SD_LOG_HARD_QUOTA_PERCENT
    int "SD queue hard quota percent"
    range 60 99
    default 95

config TRACKER_SD_RETRY_BASE_MS
    int "Replay retry base backoff ms"
    range 200 10000
    default 1000

config TRACKER_SD_RETRY_MAX_MS
    int "Replay retry max backoff ms"
    range 1000 120000
    default 30000

config TRACKER_SD_ACK_TIMEOUT_MS
    int "QoS1 ACK timeout ms"
    range 1000 60000
    default 5000

config TRACKER_IGNITION_DEBOUNCE_MS
    int "Ignition debounce window ms"
    range 100 10000
    default 1500

config TRACKER_IGNITION_OFF_DRAIN_MS
    int "Ignition OFF drain timeout ms"
    range 500 30000
    default 3000

endmenu
