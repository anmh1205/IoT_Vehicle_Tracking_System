# ESP32-S3 target features
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# Console
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Power management
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# SD logging defaults
CONFIG_TRACKER_SD_LOG_ENABLE=y
CONFIG_TRACKER_SD_REPLAY_ENABLE=y
CONFIG_TRACKER_SD_DIAG_ENABLE=y
CONFIG_TRACKER_SD_LOG_QUOTA_BYTES=4194304
CONFIG_TRACKER_SD_LOG_SOFT_QUOTA_PERCENT=80
CONFIG_TRACKER_SD_LOG_HARD_QUOTA_PERCENT=95
CONFIG_TRACKER_SD_RETRY_BASE_MS=1000
CONFIG_TRACKER_SD_RETRY_MAX_MS=30000
CONFIG_TRACKER_SD_ACK_TIMEOUT_MS=5000
CONFIG_TRACKER_IGNITION_DEBOUNCE_MS=1500
CONFIG_TRACKER_IGNITION_OFF_DRAIN_MS=3000
