# ============================================
# IoT Vehicle Tracking System - Environment
# ============================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=              # REQUIRED - no default
POSTGRES_DB=vehicle_tracking

# MQTT (EMQX)
MQTT_USERNAME=backend
MQTT_PASSWORD=                  # REQUIRED - no default

# Session Auth (database-backed tokens, NOT JWT)
SESSION_SECRET=                 # REQUIRED - min 32 chars

# CORS
CORS_ORIGIN=http://localhost:3002

# API URLs (Frontend)
API_BASE_URL=http://localhost:3000/api/v1
WS_URL=http://localhost:3000

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=               # REQUIRED - no default

# EMQX Dashboard
EMQX_DASHBOARD__DEFAULT_PASSWORD=public   # Change in production
